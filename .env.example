# Gemini API key -- required for the agent's LLM calls.
# Get one from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key

# If GEMINI_API_KEY is also set in your environment, server.py deletes it at
# startup so google-genai doesn't warn about the two being ambiguous. Set
# GOOGLE_API_KEY here and you don't need to worry about GEMINI_API_KEY at all.

# OAuth 2.0 Web Application client ID -- required for the browser login flow.
# server.py serves this to the frontend via GET /api/config; it is never
# hard-coded in static/index.html.
# Create at: https://console.cloud.google.com/apis/credentials
#   Type: Web application
#   Authorized JavaScript origins: http://localhost:8000 (dev), plus any deployed domain
OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# Minimum GCP IAM permissions for the OAuth user's account/role:
#   bigquery.jobs.create
#   bigquery.tables.getData
#   (cloudresourcemanager.readonly scope, for the project picker in /api/projects)
